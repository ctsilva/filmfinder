{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.*.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Edit(./.env.*.local)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(cat .env.local)",
      "Bash(cat .env.production)",
      "Bash(cat .env.development)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(grep * .env)",
      "Bash(source .env)",
      "Bash(. .env)"
    ]
  }
}
